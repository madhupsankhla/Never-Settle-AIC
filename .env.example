# ==============================================================================
# SoleSight Environment Configuration Template
# Copy this file to .env and provide your secret keys before starting in production.
# ==============================================================================

# OpenAI API Key for Layer 4 AI Narrative Engine & Interactive Copilot
# (Optional: If omitted, the engine uses local deterministic templates and pre-computed evidence)
OPENAI_API_KEY=your_openai_api_key_here

# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Dev Server Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_PORT=5173

# Dataset & Storage Configuration
DATASET_PATH=SoleSight-Synthetic-Dataset-6mo.xlsx

# System Environment
ENVIRONMENT=development
